{
  "name": "@dsh-desktop/file-changes",
  "version": "0.2.0",
  "description": "Tracks file writes/edits per session from the live event stream and offers guarded one-click restore (session-cwd fence + dangerous-extension blocklist).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT"
}
